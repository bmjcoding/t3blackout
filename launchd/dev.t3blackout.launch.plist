<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Inert: runs only when the app's boot guard kickstarts it (app opened from
     Finder/Dock outside the sandbox). Never runs at load, never kept alive. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.t3blackout.launch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__LAUNCHER__</string>
    <string>launch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>T3BLACKOUT_RELAUNCHED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <!-- The launcher exits right after starting the app; keep the app alive. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__STATE__/launch-agent.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE__/launch-agent.log</string>
</dict>
</plist>
