#!/usr/bin/env node
// t3blackout: build upstream T3 Code with every phone-home stripped.
//
//   t3blackout update [--ref <tag|branch|sha>] [--channel nightly|preview|stable] [--force]
//   t3blackout check  [--ref ...]      apply strip rules to latest upstream without building
//   t3blackout smoke                   re-run the zero-egress smoke test on the last build
//   t3blackout launch                  open the installed app
//   t3blackout status                  installed version, schedule, signing
//   t3blackout rollback                swap back to the previously installed build
//   t3blackout schedule [--hour 4] | unschedule   daily update (launchd / systemd timer)
//   t3blackout signing init|import|status [--vault V]   macOS: shared signing cert via 1Password

import * as fs from "node:fs";
import * as path from "node:path";
import { parseArgs } from "node:util";

import { smokeTest } from "../lib/smoke.mjs";
import { applyRules, scanForbidden } from "../lib/strip-engine.mjs";
import { forbiddenInBuild, makeRules } from "../lib/rules.mjs";
import { MIRROR, STATE, T3B_HOME, WORK, capture, log, readJson, run } from "../lib/util.mjs";

const UPSTREAM_URL = "https://github.com/pingdotgg/t3code.git";
// The app never fetches this at runtime (rule server/litellm-rates-off). Each
// update downloads it once and seeds the app's rate cache, so usage cost
// estimates keep working.
const LITELLM_RATES_URL =
  "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json";

const platform = await (async () => {
  if (process.platform === "darwin") return (await import("../lib/platform/macos.mjs")).default;
  if (process.platform === "linux") return (await import("../lib/platform/linux.mjs")).default;
  throw new Error(`unsupported platform: ${process.platform}`);
})();

// --------------------------------------------------------------- upstream --

function fetchUpstream() {
  if (!fs.existsSync(path.join(MIRROR, ".git"))) {
    run("git", ["clone", "--quiet", UPSTREAM_URL, MIRROR]);
  }
  run("git", ["-C", MIRROR, "fetch", "--quiet", "--tags", "--force", "origin"]);
}

/** Newest upstream release tag on a channel; tags look like v0.1.1-nightly.20261017.3234. */
function resolveRef(channel) {
  const pattern = { nightly: "v*-nightly.*", preview: "v*-preview.*", stable: "v[0-9]*" }[channel];
  if (!pattern) throw new Error(`unknown channel ${channel}`);
  const tags = capture("git", ["-C", MIRROR, "tag", "--list", pattern, "--sort=-creatordate"])
    .split("\n")
    .filter((tag) => channel !== "stable" || /^v\d+\.\d+\.\d+$/.test(tag));
  if (!tags[0]) throw new Error(`no ${channel} tags upstream`);
  return tags[0];
}

function checkoutWork(ref) {
  if (fs.existsSync(WORK)) {
    run("git", ["-C", MIRROR, "worktree", "remove", "--force", WORK]);
  }
  run("git", ["-C", MIRROR, "worktree", "prune"]);
  run("git", ["-C", MIRROR, "worktree", "add", "--quiet", "--detach", WORK, ref]);
  // Upstream's .env.example holds production Clerk/relay values; a stray .env
  // would bake them in. The rules already force those constants empty.
  for (const name of [".env", ".env.local"]) fs.rmSync(path.join(WORK, name), { force: true });
}

function strip() {
  log("applying strip rules");
  const failures = applyRules(WORK, makeRules());
  if (failures.length) {
    throw new Error(
      `${failures.length} strip rule(s) no longer match upstream. Nothing was installed.\n` +
        failures.map((f) => `  - ${f}`).join("\n") +
        "\nUpdate lib/rules.mjs for the new upstream code, then rerun.",
    );
  }
}

// ------------------------------------------------------------------ build --

/** Build-time env: no cloud keys, no publish tokens, nothing inherited by accident. */
function buildEnv() {
  const keep = ["HOME", "USER", "LOGNAME", "SHELL", "TMPDIR", "LANG", "TERM"];
  const env = Object.fromEntries(keep.filter((k) => process.env[k]).map((k) => [k, process.env[k]]));
  // Upstream's build spawns `vp` by name; use the repo's own vite-plus so the
  // machine doesn't need it installed globally.
  env.PATH = [path.join(WORK, "node_modules", ".bin"), process.env.PATH ?? "/usr/bin:/bin"].join(":");
  return {
    ...env,
    CI: "1",
    T3CODE_DESKTOP_SIGNED: "false",
    CSC_IDENTITY_AUTO_DISCOVERY: "false",
    T3CODE_TELEMETRY_ENABLED: "false",
    T3CODE_OTEL_SDK_DISABLED: "true",
  };
}

function buildApp() {
  const opts = { cwd: WORK, env: buildEnv() };
  log("installing dependencies");
  run("pnpm", ["install", "--frozen-lockfile"], opts);
  log(`building desktop app (${platform.name}, unsigned)`);
  run(process.execPath, ["scripts/build-desktop-artifact.ts", ...platform.buildArgs()], opts);
}

function verify(staged) {
  log("scanning build output for forbidden endpoints");
  const hits = scanForbidden(
    [
      path.join(WORK, "apps", "server", "dist"),
      path.join(WORK, "apps", "web", "dist"),
      path.join(WORK, "apps", "desktop", "dist-electron"),
      ...platform.scanRoots(staged),
    ],
    forbiddenInBuild,
  );
  if (hits.length) {
    throw new Error(`forbidden endpoints found in build output:\n${hits.map((h) => `  - ${h}`).join("\n")}`);
  }
  const html = path.join(WORK, "apps", "web", "dist", "index.html");
  if (fs.existsSync(html) && !fs.readFileSync(html, "utf8").includes("Content-Security-Policy")) {
    throw new Error("built index.html is missing the t3blackout CSP");
  }
}

/** Downloads the pricing table and writes it in the cache format UsageService reads. */
async function seedPricing() {
  try {
    const res = await fetch(LITELLM_RATES_URL, { signal: AbortSignal.timeout(60_000) });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const document = await res.json();
    if (typeof document !== "object" || document === null || Object.keys(document).length < 100) {
      throw new Error("unexpected pricing table shape");
    }
    const target = path.join(T3B_HOME, "userdata", "usage-model-rates.json");
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, JSON.stringify({ fetchedAtMs: Date.now(), document }));
    log(`seeded pricing for ${Object.keys(document).length} models`);
  } catch (error) {
    log(`warning: pricing table not refreshed (${error.message}); cost estimates keep the previous one`);
  }
}

// --------------------------------------------------------------- commands --

async function cmdUpdate(opts) {
  fetchUpstream();
  const ref = opts.ref ?? resolveRef(opts.channel);
  const sha = capture("git", ["-C", MIRROR, "rev-parse", `${ref}^{commit}`]);
  const current = readJson(path.join(STATE, "current.json"), {});
  if (current.sha === sha && !opts.force) {
    log(`already on ${ref} (${sha.slice(0, 10)}); nothing to do`);
    return;
  }
  log(`updating to ${ref} (${sha.slice(0, 10)})`);
  const build = platform.beginBuild();
  let staged = null;
  try {
    checkoutWork(sha);
    strip();
    buildApp();
    staged = platform.stage(build.findArtifact());
    verify(staged);
    await smokeTest();
    await seedPricing();
    platform.activate(staged);
    staged = null;
    const record = { ref, sha, installedAt: new Date().toISOString() };
    fs.writeFileSync(path.join(STATE, "previous.json"), JSON.stringify(current, null, 2));
    fs.writeFileSync(path.join(STATE, "current.json"), JSON.stringify(record, null, 2));
    log(`installed ${ref} -> ${platform.installedPath}`);
    platform.notify("T3 Blackout updated", `${ref} installed. Restart T3 Blackout to use it.`);
  } catch (error) {
    log(`update FAILED, keeping the installed build: ${error.message}`);
    platform.notify("T3 Blackout update failed", String(error.message).split("\n")[0]);
    process.exitCode = 1;
  } finally {
    if (staged) fs.rmSync(staged, { recursive: true, force: true });
    build.cleanup();
  }
}

function cmdCheck(opts) {
  fetchUpstream();
  const ref = opts.ref ?? resolveRef(opts.channel);
  log(`checking strip rules against ${ref}`);
  checkoutWork(ref);
  try {
    strip();
    log("all rules apply cleanly");
  } catch (error) {
    log(error.message);
    process.exitCode = 1;
  }
}

function cmdStatus() {
  const current = readJson(path.join(STATE, "current.json"), null);
  console.log(`installed: ${current?.sha ? `${current.ref} (${current.sha.slice(0, 10)}) at ${current.installedAt}` : "none"}`);
  console.log(`app:       ${fs.existsSync(platform.installedPath) ? platform.installedPath : "missing"}`);
  console.log(`schedule:  ${platform.isScheduled() ? "daily" : "off"}`);
  for (const line of platform.statusLines()) console.log(line);
}

function cmdRollback() {
  platform.rollback();
  const current = readJson(path.join(STATE, "current.json"), {});
  const previous = readJson(path.join(STATE, "previous.json"), {});
  fs.writeFileSync(path.join(STATE, "current.json"), JSON.stringify(previous, null, 2));
  fs.writeFileSync(path.join(STATE, "previous.json"), JSON.stringify(current, null, 2));
  log(`rolled back to ${previous.ref ?? "previous build"}`);
}

function cmdSchedule(opts) {
  const hour = Number(opts.hour ?? 4);
  platform.schedule(hour);
  log(`daily update scheduled at ${hour}:00`);
}

function cmdUnschedule() {
  platform.unschedule();
  log("daily update unscheduled");
}

const { positionals, values } = parseArgs({
  allowPositionals: true,
  options: {
    ref: { type: "string" },
    channel: { type: "string", default: "nightly" },
    force: { type: "boolean", default: false },
    hour: { type: "string" },
    vault: { type: "string" },
  },
});

const commands = {
  update: cmdUpdate,
  check: cmdCheck,
  smoke: () => smokeTest(),
  launch: () => platform.launch(),
  status: cmdStatus,
  rollback: cmdRollback,
  schedule: cmdSchedule,
  unschedule: cmdUnschedule,
  signing: (opts) => platform.commands.signing(opts, positionals[1]),
};

const command = commands[positionals[0] ?? "status"];
if (!command) {
  console.error(`unknown command: ${positionals[0]}\ncommands: ${Object.keys(commands).join(", ")}`);
  process.exit(2);
}
try {
  await command(values);
} catch (error) {
  log(`error: ${error.message}`);
  process.exit(1);
}
