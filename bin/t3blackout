#!/usr/bin/env node
// t3blackout: build upstream T3 Code with every phone-home stripped.
//
//   t3blackout update [--ref <tag|branch|sha>] [--channel nightly|preview|stable] [--force] [--stage-only]
//   t3blackout check  [--ref ...]      apply strip rules to latest upstream without building
//   t3blackout drift                   open what upstream changed under the features a build left out
//   t3blackout poll [--offline]        is a newer upstream release available?
//   t3blackout apply [--wait-pid N]    install a staged build once the app has quit, relaunch it
//   t3blackout smoke                   re-run the zero-egress smoke test on the last build
//   t3blackout launch                  open the installed app (installs a staged build first)
//   t3blackout status                  installed version, schedule, build account, signing
//   t3blackout rollback                swap back to the previously installed build
//   t3blackout schedule [--hour 4] [--day monday|daily] | unschedule   weekly (default) or daily update
//   t3blackout signing adopt|import|init|status [--vault V]   macOS: shared signing identity via 1Password
//
// Releases are built once they're --soak-hours old (default 48). Fetching and
// building run as the separate build account when install.sh set one up.
//
// A feature whose rules no longer match upstream is left out of the build
// (lib/features.mjs) and the update goes ahead; a strict rule (privacy, identity,
// the updater) that no longer matches holds the update at the newest release it
// still applies to.

import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import * as fs from "node:fs";
import * as path from "node:path";
import { parseArgs } from "node:util";

import { buildArtifact, checkRules } from "../lib/build.mjs";
import { builderReachable, runAsBuilder } from "../lib/builder.mjs";
import { emptyDrift, renderDriftReport } from "../lib/drift.mjs";
import { emit, enableEvents, progress } from "../lib/events.mjs";
import { featureByName, features } from "../lib/features.mjs";
import { captureLooks } from "../lib/looks.mjs";
import { forbiddenInBuild } from "../lib/rules.mjs";
import { selfUpdate } from "../lib/selfupdate.mjs";
import { smokeTest } from "../lib/smoke.mjs";
import { scanForbidden } from "../lib/strip-engine.mjs";
import { SOAK_HOURS, cliChannel, commitTime, fetchUpstreamHere, githubWebUrl, hasMirror, parseCommitLines, previousTag, releaseNotes, resolveRef, revParse, soakedTags, upstreamCommits, upstreamWebUrl, versionOf } from "../lib/upstream.mjs";
import { BUILDER_USER, IS_BUILDER, LAUNCHER, ROOT, STATE, T3B_HOME, USE_BUILDER, log, readJson, sleep } from "../lib/util.mjs";

// The app never fetches this at runtime (rule server/litellm-rates-off). Each
// update downloads it once and seeds the app's rate cache, so usage cost
// estimates keep working.
const LITELLM_RATES_URL =
  "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json";

const CURRENT = path.join(STATE, "current.json");
const PREVIOUS = path.join(STATE, "previous.json");
const PENDING = path.join(STATE, "pending.json");
const LOCK = path.join(STATE, "update.lock");
const DRIFT_DIR = path.join(STATE, "drift");
const VERDICTS = path.join(STATE, "verdicts.json");
/** How many releases back an update looks for one its strict rules still apply to. */
const MAX_FALLBACK = 5;

const platform = await (async () => {
  if (process.platform === "darwin") return (await import("../lib/platform/macos.mjs")).default;
  if (process.platform === "linux") return (await import("../lib/platform/linux.mjs")).default;
  throw new Error(`unsupported platform: ${process.platform}`);
})();

// ------------------------------------------------- the upstream half -------
// As the build account when there is one, otherwise right here.

function requireBuilder() {
  if (USE_BUILDER && !builderReachable()) {
    throw new Error(`the build account ${BUILDER_USER} exists but sudo can't switch to it; rerun ./install.sh`);
  }
}

async function fetchUpstream() {
  if (USE_BUILDER) await runAsBuilder(["fetch"]);
  else fetchUpstreamHere();
}

/**
 * What a build brings, for the version stamp's hover card: upstream commits since
 * the installed build, and t3blackout's own commits since the installed one. A
 * rebuild of the installed build has neither, so it lists upstream's changes since
 * the previous release tag and t3blackout's latest few commits instead.
 */
function buildChanges(current, sha) {
  let upstream = { since: null, items: [] };
  if (current.sha && current.sha !== sha) {
    upstream = { since: current.version ?? current.sha.slice(0, 10), items: upstreamCommits(current.sha, sha) };
  } else {
    const tag = previousTag(sha);
    if (tag) upstream = { since: tag.replace(/^v/, ""), items: upstreamCommits(tag, sha) };
  }
  const head = blackoutCommit();
  const newSinceInstall = current.blackout && head && current.blackout !== head;
  const log = spawnSync(
    "git",
    ["-C", ROOT, "log", "--no-merges", "--format=%H%x09%s", newSinceInstall ? `${current.blackout}..HEAD` : "--max-count=5"],
    { encoding: "utf8" },
  );
  const origin = spawnSync("git", ["-C", ROOT, "remote", "get-url", "origin"], { encoding: "utf8" });
  const blackout = {
    since: newSinceInstall ? (current.version ?? null) : null,
    items: log.status === 0 ? parseCommitLines(log.stdout).slice(0, 40) : [],
  };
  return {
    upstream: { ...upstream, repo: upstreamWebUrl() },
    blackout: { ...blackout, repo: origin.status === 0 ? githubWebUrl(origin.stdout) : null },
  };
}

/** Builds `sha`; returns { artifact, skipped, drift }. Saves the drift report if a strict rule stopped it. */
async function buildUpstream(sha, version, changes, current) {
  const baselines = { baseline: current.sha ?? null, features: current.baselines ?? {} };
  let drift = null;
  try {
    if (!USE_BUILDER) {
      const result = await buildArtifact({ sha, version, platform, changes, baseline: baselines.baseline, baselines: baselines.features, onDrift: (found) => (drift = found) });
      return { ...result, drift };
    }
    let result = null;
    const args = ["build-artifact", "--ref", sha, "--build-version", version, "--changes", JSON.stringify(changes), "--baselines", JSON.stringify(baselines)];
    await runAsBuilder(args, {
      onEvent: (event) => {
        if (event.type === "progress") progress(event.percent);
        else if (event.type === "drift") drift = event.drift;
        else if (event.type === "artifact") result = { artifact: event.artifact, skipped: event.skipped ?? [] };
      },
    });
    if (!result?.artifact) throw new Error("the build account finished without an app");
    return { ...result, drift };
  } catch (error) {
    if (drift) saveDriftReport(drift);
    throw error;
  }
}

// ------------------------------------------------------------ helpers ------

/** This repo's commit: a build is upstream sha + the rules that stripped it. */
const blackoutCommit = () => spawnSync("git", ["-C", ROOT, "rev-parse", "HEAD"], { encoding: "utf8" }).stdout?.trim() || null;

/**
 * Writes a drift report where `t3blackout drift` finds it, keeping the last 20.
 * A build's report is <version>.html; a check's, <version>.check.html, so checking
 * never replaces what a build left out.
 */
function saveDriftReport(drift, { check = false, looks = null } = {}) {
  fs.mkdirSync(DRIFT_DIR, { recursive: true });
  const html = renderDriftReport(drift, looks);
  const file = path.join(DRIFT_DIR, `${drift.version}${check ? ".check" : ""}.html`);
  fs.writeFileSync(file, html);
  fs.copyFileSync(file, path.join(DRIFT_DIR, "latest.html"));
  const old = fs
    .readdirSync(DRIFT_DIR)
    .filter((name) => name !== "latest.html")
    .map((name) => path.join(DRIFT_DIR, name))
    .sort((a, b) => fs.statSync(b).mtimeMs - fs.statSync(a).mtimeMs)
    .slice(20);
  for (const stale of old) fs.rmSync(stale, { force: true });
  log(`what upstream changed: ${file} (t3blackout drift)`);
}

const labelsOf = (names) => names.map((name) => featureByName(name)?.label ?? name);

/** Per feature, the upstream commit it last built against: drift reports diff from there. */
function nextBaselines(current, sha, skipped) {
  return Object.fromEntries(
    features.map(({ name }) => [name, skipped.includes(name) ? (current.baselines?.[name] ?? current.sha ?? null) : sha]),
  );
}

/** Changes whenever anything under lib/ does, committed or not: a check's verdict is only good for the rules it ran. */
function rulesDigest() {
  const hash = createHash("sha256");
  const walk = (dir) => {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
      if (entry.name.startsWith(".")) continue;
      const full = path.join(dir, entry.name);
      hash.update(full.slice(ROOT.length));
      if (entry.isDirectory()) walk(full);
      else hash.update(fs.readFileSync(full));
    }
  };
  walk(path.join(ROOT, "lib"));
  return hash.digest("hex").slice(0, 16);
}

/** Runs the strip rules against `ref` without building: { ok, message, skipped, drift }. */
async function runCheck(ref, current) {
  if (!USE_BUILDER) return checkRules(ref, { baseline: current.sha ?? null });
  let result = null;
  await runAsBuilder(["check", "--ref", ref, ...(current.sha ? ["--baseline", current.sha] : [])], {
    onEvent: (event) => {
      if (event.type === "check") result = event.result;
    },
  });
  if (!result) throw new Error("the build account's check reported nothing");
  return result;
}

/**
 * Whether the rules apply to `sha`, remembered per upstream commit and rules.
 * Unchecked and `mayCheck` false (no lock, or offline): null.
 */
async function verdictFor(ref, sha, current, mayCheck) {
  const key = `${sha}:${rulesDigest()}`;
  const verdicts = readJson(VERDICTS, {});
  if (verdicts[key]) return verdicts[key];
  if (!mayCheck) return null;
  const result = await runCheck(ref, current);
  if (!result.ok && result.drift) saveDriftReport(result.drift, { check: true });
  const verdict = { ok: result.ok, message: result.message ?? null, skipped: result.skipped ?? [], checkedAt: new Date().toISOString() };
  const kept = Object.entries(verdicts).slice(-49);
  fs.writeFileSync(VERDICTS, JSON.stringify(Object.fromEntries([...kept, [key, verdict]]), null, 2));
  return verdict;
}

/**
 * target(), but passing over releases a strict rule or a new host would stop,
 * for the newest older one that still builds; with none, stay put. Returns
 * { ref, sha, verdict, held: [{ ref, message }] }. An explicit --ref is built as is.
 */
async function chooseTarget(opts, current, { mayCheck }) {
  const newest = target(opts, current);
  if (opts.ref || newest.sha === current.sha) return { ...newest, verdict: null, held: [] };
  const tags = soakedTags(opts.channel ?? appChannel(), soakOf(opts));
  const start = Math.max(0, tags.indexOf(newest.ref));
  const held = [];
  for (const [i, ref] of tags.slice(start, start + MAX_FALLBACK).entries()) {
    const sha = revParse(ref);
    // Only the newest may be older than what's installed (a deliberate channel switch).
    if (i > 0 && current.sha && (sha === current.sha || commitTime(sha) <= commitTime(current.sha))) break;
    const verdict = await verdictFor(ref, sha, current, mayCheck);
    if (!verdict || verdict.ok) return { ref, sha, verdict, held };
    held.push({ ref, message: verdict.message ?? "the strict rules don't apply" });
    log(`passing over ${ref}: ${held.at(-1).message.split("\n")[0]}`);
  }
  // Older releases were checked last; the report to read is the newest one's.
  const newestReport = held.length ? path.join(DRIFT_DIR, `${held[0].ref.replace(/^v/, "")}.check.html`) : null;
  if (newestReport && fs.existsSync(newestReport)) fs.copyFileSync(newestReport, path.join(DRIFT_DIR, "latest.html"));
  if (!current.sha) return { ...newest, verdict: null, held };
  return { ref: current.ref, sha: current.sha, verdict: null, held };
}

/** One line on releases held back, for logs, notifications and the app. */
const heldLine = (held, installedRef) => {
  const reason = held[0].message.split("\n")[0].replace(/\.? ?Nothing was installed\.?$/, "");
  return `Staying on ${installedRef?.replace(/^v/, "") ?? "the installed build"}; ${held[0].ref.replace(/^v/, "")} needs a rule fix (${reason}). Run t3blackout drift to see why.`;
};

const channelOfRef = (ref) => (!ref ? null : /-nightly\./.test(ref) ? "nightly" : /-preview\./.test(ref) ? "preview" : "stable");

/**
 * The update track picked in the app's Settings, resolved the way the app does:
 * stored only once the user changes it, otherwise derived from the installed version.
 */
function appChannel() {
  const settings = readJson(path.join(T3B_HOME, "userdata", "desktop-settings.json"), {});
  const configured =
    settings.updateChannelConfiguredByUser === true ||
    (settings.updateChannelConfiguredByUser === undefined && settings.updateChannel === "nightly");
  if (configured && settings.updateChannel) return cliChannel(settings.updateChannel);
  const installed = channelOfRef(readJson(CURRENT, {}).ref);
  return !installed || installed === "nightly" ? "nightly" : "stable";
}

const soakOf = (opts) => (opts["soak-hours"] === undefined ? {} : { soakHours: Number(opts["soak-hours"]) });

/**
 * The release to be on: the newest soaked one on the channel, unless that's
 * older than what's installed (e.g. a build newer than the soak window, or
 * right after turning the soak on), in which case stay put. Going back is only
 * for a deliberate channel switch.
 */
function target(opts, current) {
  if (opts.ref) return { ref: opts.ref, sha: revParse(opts.ref) };
  const channel = opts.channel ?? appChannel();
  const ref = resolveRef(channel, soakOf(opts));
  const sha = revParse(ref);
  const switching = cliChannel(channel) !== channelOfRef(current.ref);
  if (current.sha && sha !== current.sha && !(opts["allow-downgrade"] && switching) && commitTime(sha) < commitTime(current.sha)) {
    return { ref: current.ref, sha: current.sha };
  }
  return { ref, sha };
}

function verifyStaged(staged) {
  log("scanning the packaged app for forbidden endpoints");
  const hits = scanForbidden(platform.scanRoots(staged), forbiddenInBuild);
  if (hits.length) throw new Error(`forbidden endpoints found in the app:\n${hits.map((h) => `  - ${h}`).join("\n")}`);
}

/** Downloads the pricing table and writes it in the cache format UsageService reads. */
async function seedPricing() {
  try {
    const res = await fetch(LITELLM_RATES_URL, { signal: AbortSignal.timeout(60_000) });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const document = await res.json();
    if (typeof document !== "object" || document === null || Object.keys(document).length < 100) {
      throw new Error("unexpected pricing table shape");
    }
    const target = path.join(T3B_HOME, "userdata", "usage-model-rates.json");
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.writeFileSync(target, JSON.stringify({ fetchedAtMs: Date.now(), document }));
    log(`seeded pricing for ${Object.keys(document).length} models`);
  } catch (error) {
    log(`warning: pricing table not refreshed (${error.message}); cost estimates keep the previous one`);
  }
}

const isAlive = (pid) => {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === "EPERM";
  }
};

/** Pid of the live process holding the update lock, if any. */
function lockHolder() {
  try {
    const pid = Number(fs.readFileSync(LOCK, "utf8"));
    return pid && isAlive(pid) ? pid : null;
  } catch {
    return null;
  }
}

/** One update or apply at a time: the daily job and the app can both start one. */
function acquireLock() {
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      fs.writeFileSync(LOCK, String(process.pid), { flag: "wx" });
      return () => fs.rmSync(LOCK, { force: true });
    } catch (error) {
      if (error.code !== "EEXIST") throw error;
      const holder = lockHolder();
      if (holder) throw new Error(`another t3blackout update is running (pid ${holder})`);
      fs.rmSync(LOCK, { force: true });
    }
  }
  throw new Error("could not take the update lock");
}

function readPending() {
  const pending = readJson(PENDING, null);
  return pending?.sha && fs.existsSync(platform.pendingPath) ? pending : null;
}

/** Swaps `dir` in as the installed app and records it. */
function install(dir, build) {
  const { ref, sha, version, blackout, skipped = [] } = build;
  const current = readJson(CURRENT, {});
  platform.activate(dir);
  if (dir !== platform.pendingPath) fs.rmSync(platform.pendingPath, { recursive: true, force: true });
  fs.rmSync(PENDING, { force: true });
  fs.writeFileSync(PREVIOUS, JSON.stringify(current, null, 2));
  const baselines = build.baselines ?? nextBaselines(current, sha, skipped);
  fs.writeFileSync(CURRENT, JSON.stringify({ ref, sha, version, blackout, skipped, baselines, installedAt: new Date().toISOString() }, null, 2));
  log(`installed ${ref} -> ${platform.installedPath}`);
}

/** Keeps a verified build until the running app restarts into it. */
function keepPending(dir, build) {
  if (dir !== platform.pendingPath) {
    fs.rmSync(platform.pendingPath, { recursive: true, force: true });
    fs.renameSync(dir, platform.pendingPath);
  }
  fs.writeFileSync(PENDING, JSON.stringify({ ...build, stagedAt: new Date().toISOString() }, null, 2));
  log(`${build.ref} is ready; it installs when T3 Blackout restarts`);
}

// --------------------------------------------------------------- commands --

async function cmdUpdate(opts) {
  // A newer t3blackout (a rule fix pushed from another machine) builds this update.
  const self = process.env.T3BLACKOUT_SELF_UPDATED ? "skipped" : selfUpdate();
  if (self === "refused") {
    platform.notify("T3 Blackout self-update refused", "origin/main has commits that aren't signed by you. See state/t3blackout.log.");
  }
  if (self === "updated") {
    const rerun = spawnSync(process.execPath, [LAUNCHER, ...process.argv.slice(2)], {
      stdio: "inherit",
      env: { ...process.env, T3BLACKOUT_SELF_UPDATED: "1" },
    });
    process.exitCode = rerun.status ?? 1;
    return;
  }
  const release = acquireLock();
  try {
    await update(opts);
  } finally {
    release();
  }
}

async function update(opts) {
  requireBuilder();
  await fetchUpstream();
  progress(10);
  const current = readJson(CURRENT, {});
  const { ref, sha, held } = await chooseTarget(opts, current, { mayCheck: true });
  if (held.length && sha === current.sha) {
    log(heldLine(held, current.ref));
    if (!opts.json) platform.notify("T3 Blackout update held", heldLine(held, current.ref));
  }
  const build = { ref, sha, version: versionOf(ref, sha), blackout: blackoutCommit() };
  const pending = readPending();
  const isBuild = (record) => record?.sha === sha && record.blackout === build.blackout;
  // The app is never swapped while it runs; it restarts into the new build.
  const stageOnly = () => opts["stage-only"] || platform.isRunning();
  if (isBuild(current) && !opts.force) {
    log(`already on ${ref} (${sha.slice(0, 10)}); nothing to do`);
    return;
  }
  if (isBuild(pending) && !opts.force) {
    if (stageOnly()) log(`${ref} is already built and waiting for T3 Blackout to restart`);
    else install(platform.pendingPath, pending);
    progress(100);
    return;
  }
  log(current.sha === sha ? `rebuilding ${ref} with the current strip rules` : `updating to ${ref} (${sha.slice(0, 10)})`);
  let staged = null;
  try {
    const { artifact, skipped, drift } = await buildUpstream(sha, build.version, buildChanges(current, sha), current);
    build.skipped = skipped;
    build.baselines = nextBaselines(current, sha, skipped);
    const leftOut = skipped.length ? ` Left out: ${labelsOf(skipped).join(", ")} (t3blackout drift shows why).` : "";
    staged = platform.stage(artifact);
    verifyStaged(staged);
    // Before/after screenshots against the installed build, for this build's report.
    const installed = fs.existsSync(platform.installedPath) ? platform.serverOf(platform.installedPath) : null;
    const looks = await captureLooks({ before: installed, after: platform.serverOf(staged) });
    saveDriftReport(drift ?? emptyDrift({ version: build.version, sha, repo: upstreamWebUrl() }), {
      looks: { ...looks, beforeVersion: installed ? (current.version ?? null) : null },
    });
    progress(95);
    await seedPricing();
    if (stageOnly()) {
      keepPending(staged, build);
      if (!opts.json) {
        platform.notify("T3 Blackout update ready", `${build.version} is built. Restart T3 Blackout from the update button in its sidebar.${leftOut}`);
      }
    } else {
      install(staged, build);
      if (!opts.json) platform.notify("T3 Blackout updated", `${build.version} installed.${leftOut}`);
    }
    staged = null;
    progress(100);
  } catch (error) {
    log(`update FAILED, keeping the installed build: ${error.message}`);
    platform.notify("T3 Blackout update failed", String(error.message).split("\n")[0]);
    emit({ type: "error", message: String(error.message).split("\n")[0] });
    process.exitCode = 1;
  } finally {
    if (staged) fs.rmSync(staged, { recursive: true, force: true });
  }
}

/** Takes the update lock if it's free; returns its release, or null. */
function tryLock() {
  try {
    return lockHolder() ? null : acquireLock();
  } catch {
    return null;
  }
}

/** Release notes, led by what Blackout will leave out of the build or held back. */
function notesFor(current, sha, version, { verdict, held }) {
  const notes = releaseNotes(current.sha, sha, version);
  const lines = [];
  if (verdict?.skipped?.length) lines.push(`- T3 Blackout leaves out: ${labelsOf(verdict.skipped).join(", ")} (upstream moved their code; the version stamp shows what changed)`);
  for (const { ref, message } of held) lines.push(`- T3 Blackout skipped ${ref.replace(/^v/, "")}: ${message.split("\n")[0]}`);
  if (!lines.length) return notes;
  if (!notes.length) return [{ version, note: lines.join("\n") }];
  return [{ ...notes[0], note: `${lines.join("\n")}\n${notes[0].note}` }, ...notes.slice(1)];
}

/**
 * Reports the release to update to if it isn't installed, or else a built one
 * waiting for a restart (e.g. rebuilt with new strip rules). Checks the user
 * starts also run the strip rules against releases not checked yet, so the app
 * never offers one a strict rule would stop.
 */
async function cmdPoll(opts) {
  // A running update is fetching into the mirror; read what it has.
  const release = opts.offline ? null : tryLock();
  try {
    if (release) await fetchUpstream();
    const current = readJson(CURRENT, {});
    const pending = readPending();
    let available = null;
    let heldUp = null;
    if (hasMirror()) {
      const chosen = await chooseTarget(opts, current, { mayCheck: Boolean(release) });
      if (chosen.sha !== current.sha) {
        const version = versionOf(chosen.ref, chosen.sha);
        const staged = pending?.sha === chosen.sha;
        // A staged build knows what it left out, compile errors included; a check only knows anchors.
        const verdict = staged && pending.skipped ? { ...chosen.verdict, skipped: pending.skipped } : chosen.verdict;
        available = { ref: chosen.ref, sha: chosen.sha, version, staged, releaseNotes: notesFor(current, chosen.sha, version, { ...chosen, verdict }) };
      } else if (chosen.held.length) {
        heldUp = heldLine(chosen.held, current.ref);
      }
    }
    if (!available && pending && pending.stagedAt > (current.installedAt ?? "")) {
      available = { ...pending, staged: true, releaseNotes: notesFor(current, pending.sha, pending.version, { verdict: pending, held: [] }) };
    }
    // Only a check the user started says why it's holding; background polls stay quiet.
    if (!available && heldUp && !opts.offline) throw new Error(heldUp);
    if (opts.json) emit({ type: "poll", update: available });
    else if (!available) console.log("up to date");
    else console.log(`${available.version} available${available.staged ? " (built, installs on restart)" : ""}`);
  } finally {
    release?.();
  }
}

const waitFor = async (condition, ms) => {
  for (const deadline = Date.now() + ms; Date.now() < deadline; await sleep(250)) {
    if (condition()) return true;
  }
  return condition();
};

/** Installs the staged build if there is one and the app isn't running. */
function applyPending() {
  if (!readPending()) return;
  const release = acquireLock();
  try {
    const pending = readPending();
    if (pending) install(platform.pendingPath, pending);
  } finally {
    release();
  }
}

/** Run by the app's "restart to update": wait for it to quit, swap, relaunch. */
async function cmdApply(opts) {
  try {
    const pid = Number(opts["wait-pid"]);
    if (pid && !(await waitFor(() => !isAlive(pid), 60_000))) throw new Error(`T3 Blackout (pid ${pid}) didn't quit`);
    if (!(await waitFor(() => !platform.isRunning(), 15_000))) throw new Error("T3 Blackout is still running");
    applyPending();
  } catch (error) {
    log(`update not applied: ${error.message}; the new build stays staged`);
    platform.notify("T3 Blackout update not applied", error.message);
    process.exitCode = 1;
  }
  // Relaunch either way: the user asked for a restart.
  platform.launch();
}

function cmdLaunch() {
  if (!platform.isRunning()) applyPending();
  platform.launch();
}

async function cmdCheck(opts) {
  const release = acquireLock();
  try {
    requireBuilder();
    await fetchUpstream();
    const ref = opts.ref ?? resolveRef(opts.channel ?? appChannel(), soakOf(opts));
    const result = await runCheck(ref, readJson(CURRENT, {}));
    if (result.drift) saveDriftReport(result.drift, { check: true });
    if (result.ok && result.skipped.length) console.log(`would leave out: ${labelsOf(result.skipped).join(", ")}`);
    if (!result.ok) process.exitCode = 1;
  } catch (error) {
    log(error.message);
    process.exitCode = 1;
  } finally {
    release();
  }
}

/** Opens the latest drift report: what upstream changed under the features a build left out. */
function cmdDrift() {
  const latest = path.join(DRIFT_DIR, "latest.html");
  if (!fs.existsSync(latest)) {
    console.log("no drift report yet: every build so far had every feature");
    return;
  }
  console.log(latest);
  spawnSync(process.platform === "darwin" ? "open" : "xdg-open", [latest], { stdio: "ignore" });
}

async function cmdSmoke() {
  requireBuilder();
  if (USE_BUILDER) await runAsBuilder(["smoke"]);
  else await smokeTest();
}

function cmdStatus() {
  const current = readJson(CURRENT, null);
  const pending = readPending();
  const builds = USE_BUILDER
    ? `as ${BUILDER_USER}${builderReachable() ? "" : " (sudo can't switch to it; rerun ./install.sh)"}`
    : "as you (./install.sh sets up a separate build account)";
  console.log(`installed: ${current?.sha ? `${current.ref} (${current.sha.slice(0, 10)}) at ${current.installedAt}` : "none"}`);
  if (current?.skipped?.length) console.log(`left out:  ${labelsOf(current.skipped).join(", ")} (t3blackout drift)`);
  if (pending) console.log(`staged:    ${pending.ref} (${pending.sha.slice(0, 10)}), installs when the app restarts`);
  console.log(`channel:   ${appChannel()}, releases built once ${SOAK_HOURS}h old`);
  console.log(`app:       ${fs.existsSync(platform.installedPath) ? platform.installedPath : "missing"}`);
  const schedule = readJson(SCHEDULE, null);
  console.log(`schedule:  ${platform.isScheduled() ? (schedule ? describeSchedule(schedule) : "daily") : "off"}`);
  console.log(`builds:    ${builds}`);
  console.log(`self-update: ${fs.existsSync(path.join(ROOT, ".allowed_signers")) ? "signed commits from origin/main" : "off (no .allowed_signers)"}`);
  for (const line of platform.statusLines()) console.log(line);
}

function cmdRollback() {
  platform.rollback();
  const current = readJson(CURRENT, {});
  const previous = readJson(PREVIOUS, {});
  fs.writeFileSync(CURRENT, JSON.stringify(previous, null, 2));
  fs.writeFileSync(PREVIOUS, JSON.stringify(current, null, 2));
  log(`rolled back to ${previous.ref ?? "previous build"}`);
}

const WEEKDAYS = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
const SCHEDULE = path.join(STATE, "schedule.json");

/** "Mondays at 4:00" or "daily at 4:00", for status and logs. */
const describeSchedule = ({ hour, weekday }) =>
  `${weekday === null ? "daily" : `${WEEKDAYS[weekday][0].toUpperCase()}${WEEKDAYS[weekday].slice(1)}s`} at ${hour}:00`;

/**
 * Weekly by default, so upstream's changes, and anything a build leaves out,
 * arrive as one batch to review; the update button still builds on demand.
 */
function cmdSchedule(opts) {
  const hour = Number(opts.hour ?? 4);
  const day = (opts.day ?? "monday").toLowerCase();
  const weekday = day === "daily" ? null : WEEKDAYS.findIndex((name) => name.startsWith(day.slice(0, 3)));
  if (weekday === -1 || !(hour >= 0 && hour <= 23)) throw new Error("usage: t3blackout schedule [--hour 0-23] [--day monday..sunday|daily]");
  platform.schedule(hour, weekday);
  fs.writeFileSync(SCHEDULE, JSON.stringify({ hour, weekday }));
  log(`update scheduled ${describeSchedule({ hour, weekday })}`);
}

function cmdUnschedule() {
  platform.unschedule();
  fs.rmSync(SCHEDULE, { force: true });
  log("scheduled update removed");
}

const { positionals, values } = parseArgs({
  allowPositionals: true,
  options: {
    ref: { type: "string" },
    channel: { type: "string" },
    force: { type: "boolean", default: false },
    "stage-only": { type: "boolean", default: false },
    offline: { type: "boolean", default: false },
    "allow-downgrade": { type: "boolean", default: false },
    "soak-hours": { type: "string" },
    "wait-pid": { type: "string" },
    "build-version": { type: "string" },
    changes: { type: "string" },
    baseline: { type: "string" },
    baselines: { type: "string" },
    json: { type: "boolean", default: false },
    hour: { type: "string" },
    day: { type: "string" },
    vault: { type: "string" },
  },
});

// What the build account runs, through lib/builder.mjs.
const builderCommands = {
  fetch: () => fetchUpstreamHere(),
  "build-artifact": async (opts) => {
    const changes = opts.changes ? JSON.parse(opts.changes) : null;
    const baselines = opts.baselines ? JSON.parse(opts.baselines) : {};
    const { artifact, skipped } = await buildArtifact({
      sha: opts.ref,
      version: opts["build-version"],
      platform,
      changes,
      baseline: baselines.baseline ?? null,
      baselines: baselines.features ?? {},
      onDrift: (drift) => emit({ type: "drift", drift }),
    });
    emit({ type: "artifact", artifact, skipped });
  },
  check: (opts) => emit({ type: "check", result: checkRules(opts.ref, { baseline: opts.baseline ?? null }) }),
  smoke: () => smokeTest(),
};

const commands = IS_BUILDER
  ? builderCommands
  : {
      update: cmdUpdate,
      check: cmdCheck,
      drift: cmdDrift,
      poll: cmdPoll,
      apply: cmdApply,
      smoke: cmdSmoke,
      launch: cmdLaunch,
      status: cmdStatus,
      rollback: cmdRollback,
      schedule: cmdSchedule,
      unschedule: cmdUnschedule,
      signing: (opts) => platform.commands.signing(opts, positionals[1]),
    };

const command = commands[positionals[0] ?? "status"];
if (!command) {
  console.error(`unknown command: ${positionals[0]}\ncommands: ${Object.keys(commands).join(", ")}`);
  process.exit(2);
}
enableEvents(values.json);
try {
  await command(values);
} catch (error) {
  log(`error: ${error.message}`);
  emit({ type: "error", message: String(error.message).split("\n")[0] });
  process.exit(1);
}
